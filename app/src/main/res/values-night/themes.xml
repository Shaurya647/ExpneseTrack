<resources>
    <!-- Force light theme in dark mode — app uses a custom light-only design -->
    <style name="Theme.ExpenseTrack" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/primary</item>

        <!-- Ensure white/light background even in dark mode -->
        <item name="android:windowBackground">@color/background</item>

        <!-- Status bar & Navigation bar configuration -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>